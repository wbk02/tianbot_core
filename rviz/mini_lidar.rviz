Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: laser
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: 原始雷达点云
      Enabled: true
      Topic:
        Value: /tianbot/lidar_points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 0; 255; 128
      Style: Points
      Size (Pixels): 4
      Size (m): 0.03
      Alpha: 1
      Decay Time: 0
      Queue Size: 10
    - Class: rviz_default_plugins/LaserScan
      Name: 建图扫描
      Enabled: false
      Topic:
        Value: /tianbot/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Style: Points
      Size (Pixels): 3
      Size (m): 0.03
      Alpha: 1
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 70
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Width: 1200
  Height: 800
